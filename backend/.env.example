APP_ENV=development

# STT demo. Use small for a faster first smoke test or turbo for the best pilot quality.
STT_MODEL=turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=vi
STT_BEAM_SIZE=5

# Leave empty to use backend/data/verified_aliases.jsonl.
# You can point this at pbl6_base's full datastore later.
STT_DATASTORE_PATH=
STT_UPLOAD_DIR=data/stt_uploads
STT_MAX_UPLOAD_MB=100

# Optional until the other backend modules enable Supabase/authentication.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=local-demo-only-change-me
